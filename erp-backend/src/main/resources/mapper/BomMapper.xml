<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.erp.mapper.BomMapper">
    <resultMap id="BaseResultMap" type="com.erp.entity.Bom">
        <id column="id" property="id"/>
        <result column="product_id" property="productId"/>
        <result column="material_id" property="materialId"/>
        <result column="material_name" property="materialName"/>
        <result column="specification" property="specification"/>
        <result column="unit" property="unit"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bom (product_id, material_id, material_name, specification, unit, price, quantity, create_time)
        VALUES (#{productId}, #{materialId}, #{materialName}, #{specification}, #{unit}, #{price}, #{quantity}, NOW())
    </insert>

    <update id="update">
        UPDATE bom SET quantity=#{quantity} WHERE id=#{id}
    </update>

    <delete id="deleteById">DELETE FROM bom WHERE id=#{id}</delete>
    <delete id="deleteByProductId">DELETE FROM bom WHERE product_id=#{productId}</delete>

    <select id="selectByProductId" resultMap="BaseResultMap">
        SELECT * FROM bom WHERE product_id=#{productId} ORDER BY id
    </select>

    <select id="selectAll" resultMap="BaseResultMap">SELECT * FROM bom ORDER BY product_id, id</select>
</mapper>
